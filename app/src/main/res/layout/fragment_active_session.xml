<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Карта на заднем фоне -->
    <FrameLayout
        android:id="@+id/map_container"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:background="@color/primary">

        <!-- Здесь будет ваша карта (MapView или MapFragment) -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/map_screenshot"
            android:scaleType="centerCrop"/>
    </FrameLayout>

    <!-- Bottom Sheet с информацией о сессии -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/bottom_sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/rounded_top_background"
        android:padding="16dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        app:behavior_peekHeight="200dp"
        app:behavior_hideable="true"
        android:layout_marginTop="150dp"
        app:layout_constraintBottom_toBottomOf="parent">



    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_anchor="@+id/bottom_sheet"
        app:layout_anchorGravity="top|center"
        android:padding="16dp">

        <!-- Ручка для свайпа -->
        <View
            android:id="@+id/swipe_handle"
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="4dp"
            android:background="@color/gray"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Заголовок -->
        <TextView
            android:id="@+id/tv_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:text="@string/charging_title"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            app:layout_constraintTop_toBottomOf="@id/swipe_handle" />

        <!-- Карточка станции (как в списке) -->
        <include
            android:id="@+id/station_card"
            layout="@layout/item_station"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/tv_header" />

        <!-- Разделитель -->
        <View
            android:id="@+id/divider1"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="@color/gray_light"
            app:layout_constraintTop_toBottomOf="@id/station_card" />

        <!-- Номер сессии -->
        <TextView
            android:id="@+id/tv_session_id_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/session_id_label"
            android:textStyle="bold"
            android:textColor="@color/station_name_black"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/divider1" />

        <TextView
            android:id="@+id/tv_session_id"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="@string/session_id_example"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/tv_session_id_label"
            app:layout_constraintTop_toTopOf="@id/tv_session_id_label" />

        <!-- Продолжительность -->
        <TextView
            android:id="@+id/tv_duration_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/duration_label"
            android:textStyle="bold"
            android:textColor="@color/station_name_black"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_session_id_label" />

        <TextView
            android:id="@+id/tv_duration"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="@string/duration"
            android:textSize="16sp"
            android:textColor="@color/text_secondary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/tv_duration_label"
            app:layout_constraintTop_toTopOf="@id/tv_duration_label" />

        <!-- Текущая мощность -->
        <TextView
            android:id="@+id/tv_current_power_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/current_power_label"
            android:textStyle="bold"
            android:textColor="@color/station_name_black"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_duration_label" />

        <TextView
            android:id="@+id/tv_current_power"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="@string/current_power"
            android:textSize="16sp"
            android:textColor="@color/text_secondary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/tv_current_power_label"
            app:layout_constraintTop_toTopOf="@id/tv_current_power_label" />

        <!-- Общее потребление -->
        <TextView
            android:id="@+id/tv_power_consumed_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/power_consumed_label"
            android:textStyle="bold"
            android:textColor="@color/station_name_black"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_current_power_label" />

        <TextView
            android:id="@+id/tv_power_consumed"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="@string/power_consumed"
            android:textSize="16sp"
            android:textColor="@color/text_secondary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/tv_power_consumed_label"
            app:layout_constraintTop_toTopOf="@id/tv_power_consumed_label" />

        <!-- Тариф -->
        <TextView
            android:id="@+id/tv_tariff_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/tariff_title"
            android:textStyle="bold"
            android:textColor="@color/station_name_black"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_power_consumed_label" />

        <TextView
            android:id="@+id/tv_tariff"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="@string/tariff"
            android:textSize="16sp"
            android:textColor="@color/text_secondary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/tv_tariff_label"
            app:layout_constraintTop_toTopOf="@id/tv_tariff_label" />

        <!-- Разделитель -->
        <View
            android:id="@+id/divider2"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="@color/gray_light"
            app:layout_constraintTop_toBottomOf="@id/tv_tariff_label" />

        <!-- Блок с итоговой стоимостью -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cw_total"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="8dp"
            android:layout_marginVertical="8dp"
            app:layout_constraintTop_toBottomOf="@id/divider2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tv_total_cost_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/total_cost_label"
                    android:textSize="16sp"
                    android:textStyle="bold"
                   />

                <TextView
                    android:id="@+id/tv_total_cost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="@string/total_cost"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Разделитель -->
        <View
            android:id="@+id/divider3"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="@color/gray_light"
            app:layout_constraintTop_toBottomOf="@id/cw_total" />
        <!-- Кнопка остановки -->
        <Button
            android:id="@+id/btn_stop"
            style="@style/RoundedButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:backgroundTint="@color/green"
            android:text="@string/stop_charging"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:layout_marginVertical="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="divider3"
            app:layout_constraintTop_toBottomOf="@id/divider3" />

    </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>