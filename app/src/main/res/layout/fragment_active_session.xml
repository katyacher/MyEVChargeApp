<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Карта на заднем фоне -->
    <FrameLayout
        android:id="@+id/map_container"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:background="@color/primary">

        <!-- Здесь будет ваша карта (MapView или MapFragment) -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/map_screenshot"
            android:scaleType="centerCrop"/>
    </FrameLayout>

    <!-- Bottom Sheet с информацией о сессии -->
    <com.google.android.material.bottomsheet.BottomSheetBehavior
        android:id="@+id/bottom_sheet_behavior"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:behavior_peekHeight="200dp"
        app:behavior_hideable="true">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/rounded_top_background"
            android:padding="16dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Заголовок -->
                <TextView
                    android:id="@+id/tv_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Заряжается"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginBottom="16dp"
                    app:layout_constraintTop_toTopOf="parent"/>

                <!-- Карточка станции (как в списке) -->
                <include
                    android:id="@+id/station_card"
                    layout="@layout/item_station"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@id/tv_header"/>

                <!-- Разделитель -->
                <View
                    android:id="@+id/divider1"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/gray_light"
                    android:layout_marginVertical="16dp"
                    app:layout_constraintTop_toBottomOf="@id/station_card"/>

                <!-- Номер сессии -->
                <TextView
                    android:id="@+id/tv_session_id_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Номер сессии:"
                    android:textColor="@color/gray"
                    app:layout_constraintTop_toBottomOf="@id/divider1"
                    app:layout_constraintStart_toStartOf="parent"/>

                <TextView
                    android:id="@+id/tv_session_id"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="12345"
                    android:textSize="16sp"
                    app:layout_constraintTop_toTopOf="@id/tv_session_id_label"
                    app:layout_constraintStart_toEndOf="@id/tv_session_id_label"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <!-- Продолжительность -->
                <TextView
                    android:id="@+id/tv_duration_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Продолжительность:"
                    android:textColor="@color/gray"
                    android:layout_marginTop="16dp"
                    app:layout_constraintTop_toBottomOf="@id/tv_session_id_label"
                    app:layout_constraintStart_toStartOf="parent"/>

                <TextView
                    android:id="@+id/tv_duration"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="00:15:26"
                    android:textSize="16sp"
                    app:layout_constraintTop_toTopOf="@id/tv_duration_label"
                    app:layout_constraintStart_toEndOf="@id/tv_duration_label"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <!-- Текущая мощность -->
                <TextView
                    android:id="@+id/tv_current_power_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Текущая мощность:"
                    android:textColor="@color/gray"
                    android:layout_marginTop="16dp"
                    app:layout_constraintTop_toBottomOf="@id/tv_duration_label"
                    app:layout_constraintStart_toStartOf="parent"/>

                <TextView
                    android:id="@+id/tv_current_power"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="23,86 кВт"
                    android:textSize="16sp"
                    app:layout_constraintTop_toTopOf="@id/tv_current_power_label"
                    app:layout_constraintStart_toEndOf="@id/tv_current_power_label"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <!-- Общее потребление -->
                <TextView
                    android:id="@+id/tv_power_consumed_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Общее потребление:"
                    android:textColor="@color/gray"
                    android:layout_marginTop="16dp"
                    app:layout_constraintTop_toBottomOf="@id/tv_current_power_label"
                    app:layout_constraintStart_toStartOf="parent"/>

                <TextView
                    android:id="@+id/tv_power_consumed"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="5,46 кВт*ч"
                    android:textSize="16sp"
                    app:layout_constraintTop_toTopOf="@id/tv_power_consumed_label"
                    app:layout_constraintStart_toEndOf="@id/tv_power_consumed_label"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <!-- Тариф -->
                <TextView
                    android:id="@+id/tv_tariff_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Тариф:"
                    android:textColor="@color/gray"
                    android:layout_marginTop="16dp"
                    app:layout_constraintTop_toBottomOf="@id/tv_power_consumed_label"
                    app:layout_constraintStart_toStartOf="parent"/>

                <TextView
                    android:id="@+id/tv_tariff"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="5 руб/кВт*ч"
                    android:textSize="16sp"
                    app:layout_constraintTop_toTopOf="@id/tv_tariff_label"
                    app:layout_constraintStart_toEndOf="@id/tv_tariff_label"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <!-- Разделитель -->
                <View
                    android:id="@+id/divider2"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/gray_light"
                    android:layout_marginVertical="16dp"
                    app:layout_constraintTop_toBottomOf="@id/tv_tariff_label"/>

                <!-- Блок с итоговой стоимостью -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="8dp"
                    app:cardBackgroundColor="@color/gray_light"
                    app:layout_constraintTop_toBottomOf="@id/divider2"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Итого:"
                            android:textSize="16sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/tv_total_cost"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="81,9 руб"
                            android:textSize="16sp"
                            android:textStyle="bold"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Кнопка остановки -->
                <Button
                    android:id="@+id/btn_stop"
                    style="@style/RoundedButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Остановить зарядку"
                    android:textSize="16sp"
                    android:textAllCaps="false"
                    android:backgroundTint="@color/green"
                    android:textColor="@color/white"
                    app:layout_constraintTop_toBottomOf="@id/divider2"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>
    </com.google.android.material.bottomsheet.BottomSheetBehavior>
</androidx.coordinatorlayout.widget.CoordinatorLayout>