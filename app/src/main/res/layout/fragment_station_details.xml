<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Карта на заднем фоне -->
    <FrameLayout
        android:id="@+id/map_container"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:background="@color/primary">

        <!-- Здесь будет ваша карта (MapView или MapFragment) -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/map_screenshot"
            android:scaleType="centerCrop"/>
    </FrameLayout>
<androidx.core.widget.NestedScrollView
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/bottom_sheet"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/rounded_top_background"
    android:padding="16dp"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
    app:behavior_peekHeight="200dp"
    app:behavior_hideable="true"
    android:layout_marginTop="270dp"
    app:layout_constraintBottom_toBottomOf="parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Ручка для свайпа -->
        <View
            android:id="@+id/swipe_handle"
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="4dp"
            android:background="@color/gray"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <include
            android:id="@+id/station_card"
            layout="@layout/item_station"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/swipe_handle" />

        <!-- Разделитель после краткой информации -->
        <View
            android:id="@+id/divider1"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="@color/gray_light"
            app:layout_constraintTop_toBottomOf="@id/station_card"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Блок с подробной информацией -->
        <!-- Блок с иконкой разъема и подписью -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/connector_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/divider1">

            <!-- Иконка разъема -->
            <ImageView
                android:id="@+id/iv_connector_type"
                android:layout_width="78dp"
                android:layout_height="78dp"
                android:src="@drawable/ic_ccs2"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- Надпись CCS2 -->
            <TextView
                android:id="@+id/tv_connector_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/connector_ccs2"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:layout_marginTop="-8dp"
                app:layout_constraintTop_toBottomOf="@id/iv_connector_type"
                app:layout_constraintStart_toStartOf="@id/iv_connector_type"
                app:layout_constraintEnd_toEndOf="@id/iv_connector_type"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Местоположение -->
        <TextView
            android:id="@+id/tv_location_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/location_title"
            android:textColor="@color/black"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/connector_container"
            app:layout_constraintTop_toTopOf="@id/connector_container"/>

        <TextView
            android:id="@+id/tv_location"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/text_secondary"
            app:layout_constraintStart_toEndOf="@id/tv_location_label"
            app:layout_constraintTop_toTopOf="@id/tv_location_label"
            app:layout_constraintEnd_toEndOf="parent"
            android:text="@string/location"/>

        <!-- Мощность -->
        <TextView
            android:id="@+id/tv_power_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/power_title"
            android:textColor="@color/black"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@id/tv_location_label"
            app:layout_constraintTop_toBottomOf="@id/tv_location_label"/>

        <TextView
            android:id="@+id/tv_power"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/text_secondary"
            app:layout_constraintStart_toEndOf="@id/tv_power_label"
            app:layout_constraintTop_toTopOf="@id/tv_power_label"
            app:layout_constraintEnd_toEndOf="parent"
           android:text="@string/power"/>

        <!-- Тариф -->
        <TextView
            android:id="@+id/tv_tariff_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/tariff_title"
            android:textColor="@color/black"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@id/tv_power_label"
            app:layout_constraintTop_toBottomOf="@id/tv_power_label"/>

        <TextView
            android:id="@+id/tv_tariff"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/text_secondary"
            app:layout_constraintStart_toEndOf="@id/tv_tariff_label"
            app:layout_constraintTop_toTopOf="@id/tv_tariff_label"
            app:layout_constraintEnd_toEndOf="parent"
            android:text="@string/tariff"/>

        <!-- Статус -->
        <TextView
            android:id="@+id/tv_availability_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/status_title"
            android:textColor="@color/black"
            app:layout_constraintStart_toStartOf="@id/tv_tariff_label"
            app:layout_constraintTop_toBottomOf="@id/tv_tariff_label"/>

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/status_background"
            android:padding="4dp"
            android:textColor="@color/white"
            android:textSize="12sp"
            app:layout_constraintStart_toEndOf="@id/tv_availability_label"
            app:layout_constraintTop_toTopOf="@id/tv_availability_label"
            tools:text="@string/station_status_free"/>

        <!-- Разделитель перед кнопкой -->
        <View
            android:id="@+id/divider2"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="@color/gray_light"
            app:layout_constraintTop_toBottomOf="@id/tv_availability_label"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Кнопка "Начать зарядку" -->
        <Button
            android:id="@+id/btn_start_charging"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="16dp"
            android:text="@string/start_charging"
            android:backgroundTint="@color/primary"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textAllCaps="false"
            style="@style/RoundedButton"
            app:layout_constraintTop_toBottomOf="@id/divider2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
</FrameLayout>