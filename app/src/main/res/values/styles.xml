<resources>
    <!-- Базовая тема приложения -->
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Цвет основного -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>

        <item name="switchStyle">@style/CustomSwitch</item>
        <item name="textAppearanceBody1">@style/Text.Body</item>
    </style>

    <!-- Стили для нижней навигации -->
    <!-- Стиль для активной подписи -->
    <style name="BottomNavTextActive" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/roboto_medium</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Стиль для неактивной подписи -->
    <style name="BottomNavTextInactive" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/roboto_regular</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <!-- Текстовые стили -->
    <style name="Text">
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">@font/roboto_medium</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>


    <style name="Text.Title">
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">@font/roboto_medium</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
    <style name="Text.Body">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/roboto_regular</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Стили для Switch -->
    <style name="CustomSwitch" parent="Theme.AppCompat.Light">
        <item name="colorControlActivated">@color/primary</item> <!-- Цвет включенного состояния -->
        <item name="colorSwitchThumbNormal">@color/gray_light</item> <!-- Цвет выключенного состояния -->
        <item name="android:textColor">@color/primary</item> <!-- Цвет текста -->
    </style>

    <!-- Стили для кнопок -->
    <style name="RoundedButton" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">8dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
</resources>